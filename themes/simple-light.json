{
    "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
    "name": "Simple Light",
    "author": "Filip Seman",
    "themes": [
        {
            "name": "Simple Light",
            "appearance": "light",
            "style": {
                "editor.diff_hunk.added.background": "#CDE8BB",
                "editor.diff_hunk.added.hollow_background": "#CDE8BB40",
                "editor.diff_hunk.deleted.background": "#FFCDD2",
                "editor.diff_hunk.deleted.hollow_background": "#FFCDD240",

                "background": "#F8F8F8",
                "surface.background": "#F8F8F8",
                "elevated_surface.background": "#F8F8F8",
                "drop_target.background": "#E7EFFD80",

                "border": "#C4C4C4",
                "border.variant": "#E5E5E5",
                "border.focused": "#88ADF7",
                "border.selected": "#88ADF7",
                "border.transparent": "#00000000",
                "border.disabled": "#E5E5E5",

                "element.background": "#E7EFFD",
                "element.hover": "#DAE6FD",
                "element.active": "#C9DAFB",
                "element.selected": "#DFE1E5",
                "element.disabled": "#EBECF0",

                "ghost_element.background": "#00000000",
                "ghost_element.hover": "#DFE1E5",
                "ghost_element.active": "#D4D6DA",
                "ghost_element.selected": "#A6D2FF",
                "ghost_element.disabled": "#EBECF0",

                "text": "#000000",
                "text.muted": "#000000",
                "text.placeholder": "#868686",
                "text.disabled": "#868686",
                "text.accent": "#0033B3",

                "icon": "#3B3B3B",
                "icon.muted": "#616161",
                "icon.disabled": "#868686",
                "icon.placeholder": "#868686",
                "icon.accent": "#0033B3",

                "status_bar.background": "#F8F8F8",
                "title_bar.background": "#F8F8F8",
                "title_bar.inactive_background": "#F8F8F8",
                "toolbar.background": "#FFFFFF",
                "tab_bar.background": "#F8F8F8",
                "tab.active_background": "#FFFFFF",
                "tab.inactive_background": "#F8F8F8",

                "panel.background": "#FFFFFF",
                "panel.focused_border": "#88ADF7",
                "pane.focused_border": "#88ADF7",
                "pane_group.border": "#E5E5E5",

                "editor.background": "#FFFFFF",
                "editor.foreground": "#000000",
                "editor.gutter.background": "#FFFFFF",
                "editor.subheader.background": "#F8F8F8",
                "editor.active_line.background": "#F5F8FE",
                "editor.highlighted_line.background": "#E7EFFD",
                "editor.line_number": "#6E7681",
                "editor.active_line_number": "#171184",
                "editor.invisible": "#D3D3D3",
                "editor.wrap_guide": "#E5E5E51A",
                "editor.active_wrap_guide": "#E5E5E533",
                "editor.indent_guide": "#D3D3D3",
                "editor.indent_guide_active": "#C4C4C4",
                "editor.document_highlight.read_background": "#EDEBFC",
                "editor.document_highlight.write_background": "#FCE8F4",
                "editor.document_highlight.bracket_background": "#93D9D9",

                "search.match_background": "#FFDD0080",

                "scrollbar.thumb.background": "#C4C4C44C",
                "scrollbar.thumb.hover_background": "#C4C4C4",
                "scrollbar.thumb.border": "#C4C4C4",
                "scrollbar.track.background": "#00000000",
                "scrollbar.track.border": "#E5E5E5",

                "link_text.hover": "#005FB8",

                "error": "#F85149",
                "error.background": "#FDE8E8",
                "error.border": "#F85149",

                "warning": "#9A5A00",
                "warning.background": "#FDF6E3",
                "warning.border": "#9A5A00",

                "info": "#0033B3",
                "info.background": "#E7EFFD",
                "info.border": "#88ADF7",

                "hint": "#616161",
                "hint.background": "#F5F8FE",
                "hint.border": "#88ADF7",

                "success": "#2EA043",
                "success.background": "#E0F0E0",
                "success.border": "#2EA043",

                "created": "#067D17",
                "created.background": "#7FC78440",
                "created.border": "#7FC784",

                "modified": "#0033B3",
                "modified.background": "#88ADF740",
                "modified.border": "#88ADF7",

                "deleted": "#6C707E",
                "deleted.background": "#767A8A40",
                "deleted.border": "#767A8A",

                "conflict": "#DE1B2E",
                "conflict.background": "#DE1B2E20",
                "conflict.border": "#DE1B2E",

                "hidden": "#6B7280",
                "hidden.background": "#F3F4F6",
                "hidden.border": "#E5E7EB",

                "ignored": "#9CA3AF",
                "ignored.background": "#F9FAFB",
                "ignored.border": "#E5E7EB",

                "players": [
                    {
                        "cursor": "#0033B3",
                        "background": "#0033B3",
                        "selection": "#A6D2FF80"
                    },
                    {
                        "cursor": "#862F95",
                        "background": "#862F95",
                        "selection": "#862F9540"
                    },
                    {
                        "cursor": "#2EA043",
                        "background": "#2EA043",
                        "selection": "#2EA04340"
                    },
                    {
                        "cursor": "#9A5A00",
                        "background": "#9A5A00",
                        "selection": "#9A5A0040"
                    }
                ],

                "terminal.background": "#FFFFFF",
                "terminal.foreground": "#000000",
                "terminal.bright_foreground": "#000000",
                "terminal.dim_foreground": "#3D3D3D",
                "terminal.ansi.black": "#4A4A4A",
                "terminal.ansi.bright_black": "#707070",
                "terminal.ansi.red": "#D1594C",
                "terminal.ansi.bright_red": "#FF6B6B",
                "terminal.ansi.green": "#1B7D34",
                "terminal.ansi.bright_green": "#2EA043",
                "terminal.ansi.yellow": "#B8860B",
                "terminal.ansi.bright_yellow": "#FFA500",
                "terminal.ansi.blue": "#0052A3",
                "terminal.ansi.bright_blue": "#0066FF",
                "terminal.ansi.magenta": "#7D2F7F",
                "terminal.ansi.bright_magenta": "#A960C0",
                "terminal.ansi.cyan": "#0066CC",
                "terminal.ansi.bright_cyan": "#0099FF",
                "terminal.ansi.white": "#4A4A4A",
                "terminal.ansi.bright_white": "#FFFFFF",

                "syntax": {
                    "keyword": {
                        "color": "#000000",
                        "font_weight": 500
                    },

                    "variable": {
                        "color": "#000000FF"
                    },
                    "variable.special": {
                        "color": "#000000",
                        "font_weight": 500
                    },

                    "string": {
                        "color": "#007744FF"
                    },
                    "string.escape": {
                        "color": "#007744FF"
                    },
                    "string.regex": {
                        "color": "#007744FF"
                    },
                    "string.special": {
                        "color": "#007744FF"
                    },
                    "string.special.symbol": {
                        "color": "#007744FF"
                    },

                    "number": {
                        "color": "#9C6B00FF"
                    },
                    "boolean": {
                        "color": "#000000FF"
                    },
                    "constant": {
                        "color": "#000000FF"
                    },

                    "comment": {
                        "color": "#969696FF"
                    },
                    "comment.doc": {
                        "color": "#969696",
                        "font_style": "italic"
                    },

                    "function": {
                        "color": "#000000FF"
                    },
                    "type": {
                        "color": "#000000FF"
                    },
                    "constructor": {
                        "color": "#000000",
                        "font_weight": 500
                    },
                    "enum": {
                        "color": "#000000FF"
                    },
                    "variant": {
                        "color": "#000000FF"
                    },
                    "namespace": {
                        "color": "#000000FF"
                    },

                    "operator": {
                        "color": "#000000FF"
                    },
                    "punctuation": {
                        "color": "#000000FF"
                    },
                    "punctuation.bracket": {
                        "color": "#000000FF"
                    },
                    "punctuation.delimiter": {
                        "color": "#000000FF"
                    },
                    "punctuation.special": {
                        "color": "#000000FF"
                    },
                    "punctuation.list_marker": {
                        "color": "#000000FF"
                    },

                    "property": {
                        "color": "#000000",
                        "font_weight": 500
                    },
                    "attribute": {
                        "color": "#000000FF"
                    },
                    "tag": {
                        "color": "#000000",
                        "font_weight": 500
                    },
                    "selector": {
                        "color": "#000000FF"
                    },
                    "label": {
                        "color": "#000000FF"
                    },
                    "preproc": {
                        "color": "#000000",
                        "font_weight": 500
                    },
                    "embedded": {
                        "color": "#000000FF"
                    },

                    "title": {
                        "color": "#000000",
                        "font_weight": 500
                    },
                    "emphasis": {
                        "color": "#000000",
                        "font_style": "italic"
                    },
                    "emphasis.strong": {
                        "color": "#000000",
                        "font_weight": 500
                    },
                    "link_text": {
                        "color": "#000000FF"
                    },
                    "link_uri": {
                        "color": "#000000FF"
                    }
                }
            }
